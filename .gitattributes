# Large media under public/images/ is kept in Git LFS (GitHub refuses files over 100 MB, warns above 50 MB).
# content.yml checks out with lfs: true. Images and PDFs stay in plain git.
public/images/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
public/images/**/*.webm filter=lfs diff=lfs merge=lfs -text
public/images/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
