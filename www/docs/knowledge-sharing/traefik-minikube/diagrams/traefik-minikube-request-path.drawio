        <mxCell id="dns" value="Cloudflare DNS, DNS only&#10;A records: apex, www, db&#10;point at the host, no CDN proxy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
