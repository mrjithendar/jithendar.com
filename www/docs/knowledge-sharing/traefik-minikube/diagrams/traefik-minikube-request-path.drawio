        </mxCell>
        <mxCell id="haproxy" value="HAProxy 3.2 container from expose-ingress.sh: TCP mode, holds no certificates&#10;host :80 → mk4 node :30080 and host :443 → mk4 node :30443&#10;adds a PROXY protocol v2 header, so Traefik sees the visitor's address instead of the node's" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eef2ff;strokeColor=#4338ca;fontColor=#1e1b4b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="148" width="840" height="64" as="geometry" />
        </mxCell>
        <mxCell id="nodeport" value="Service traefik, type NodePort&#10;80 → nodePort 30080 → pod :8000 (web)    443 → nodePort 30443 → pod :8443 (websecure)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="280" width="810" height="46" as="geometry" />
        </mxCell>
        <mxCell id="traefik" value="Traefik v3.7.14 from Helm chart 42.0.0, 1 replica&#10;entryPoints web and websecure trust the PROXY header from 192.168.49.0/24 only&#10;TLS ends here: default TLSStore → Secret jithendar-com-tls (Let's Encrypt via cert-manager HTTP-01)&#10;providers: kubernetesingress (IngressClass traefik) and kubernetescrd, all namespaces; no Gateway API&#10;middlewares: redirects, compress, basicAuth, ipAllowList, headers; upstream connections are plain HTTP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="348" width="810" height="96" as="geometry" />
        </mxCell>
        <mxCell id="jithendar" value="ns jithendar&#10;/ → jithendar-com:80&#10;/db → jithendar-db-ui:80&#10;db.jithendar.com (TCP, SNI)&#10;→ jithendar-postgres:5432" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="490" width="195" height="96" as="geometry" />
