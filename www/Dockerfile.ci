# syntax=docker/dockerfile:1
# CI image: packages the standalone build that the CI job already produced on the linux/arm64
# runner (lint, tests and build run in parallel there). Debian slim, not Alpine: the traced native
# modules (sharp) are built for glibc on the runner. The multi-stage Dockerfile remains for local builds.
FROM node:26-bookworm-slim
WORKDIR /app
ARG GIT_SHA=dev
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 GIT_SHA=$GIT_SHA
COPY --chown=1000:1000 .next/standalone ./
COPY --chown=1000:1000 .next/static ./.next/static
COPY --chown=1000:1000 public ./public
USER 1000:1000
EXPOSE 3000
CMD ["node", "server.js"]
