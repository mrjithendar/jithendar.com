# Copy to .env.local for local development. No secrets are needed in Phase 2.

# Deployment environment. Only "production" may be indexed by search engines;
# every other value adds noindex (meta tag at build time, X-Robots-Tag at request time).
APP_ENV=development

# Canonical origin used for canonical URLs, sitemaps, feeds and JSON-LD. No trailing slash.
SITE_URL=https://jithendar.com

# Optional: read content from another directory (tests use tests/fixtures/content).
# CONTENT_DIR=

# --- Media storage: Cloudflare R2 (S3-compatible API). Server-side only; never prefix with NEXT_PUBLIC_. ---
# Objects are written to jithendar/www/media/{type}/{yyyy}/{mm}/{id}.{ext} inside this bucket.
# Without these, an admin can configure R2 under Admin → Storage instead (stored encrypted in Postgres).
# R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# R2_BUCKET=jithendar-media
# R2_ACCESS_KEY_ID=replace-me
# R2_SECRET_ACCESS_KEY=replace-me
# Optional public delivery domain connected to the bucket (large video/audio/PDF redirect here):
# R2_PUBLIC_BASE_URL=https://media.jithendar.com
# Optional API endpoint override (EU jurisdiction bucket, or a local S3 emulator for development):
# R2_ENDPOINT=https://0123456789abcdef0123456789abcdef.eu.r2.cloudflarestorage.com

# --- "Generate image" in the editor: Gemini API (server-side only). Off unless both are set. ---
# GEMINI_API_KEY=replace-me
# Model code from https://ai.google.dev/gemini-api/docs/models (an image-generation model).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=1K                      # 512 | 1K | 2K | 4K (model-dependent)
# GEMINI_IMAGE_TIMEOUT_MS=90000
# GEMINI_IMAGE_USER_HOURLY_LIMIT=10
# GEMINI_IMAGE_USER_CONCURRENCY=1
# GEMINI_IMAGE_DAILY_LIMIT=50               # whole site, per rolling 24 hours

# Local development without DATABASE_URL uses an embedded database in .data/pglite.
# PGLITE_DIR=.data/pglite

# --- Search engines, analytics and ads (public identifiers, not secrets; runtime, no rebuild) ----------
# In Kubernetes these come from the optional ConfigMap jithendar-com-public (scripts/set-public-config.sh).
# HTML-tag verification (prefer DNS verification for Google; see docs/SEO_ANALYTICS_ADS.md):
# GOOGLE_SITE_VERIFICATION=token-from-search-console
# BING_SITE_VERIFICATION=token-from-bing-webmaster-tools
# Google Analytics 4 (production only; never loaded on /admin, /login, /account, /setup, /preview):
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Google AdSense (production only; ADSENSE_TEST_MODE=true shows Google test ads in other environments):
# ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# ADSENSE_SLOT_ARTICLE_END=0000000000
# ADSENSE_TEST_MODE=false
# Exact ads.txt line(s) from your AdSense account; "\n" separates lines. Unset → /ads.txt returns 404.
# ADS_TXT=google.com, pub-0000000000000000, DIRECT, f08c47fec0942fa0
# Consent Mode default: regional (denied in EEA/UK/CH until consent) or strict (denied everywhere).
# CONSENT_DEFAULT=regional
# IndexNow key (8–128 of a-z A-Z 0-9 -), served at /<key>.txt; submissions only in production:
# INDEXNOW_KEY=generate-with-openssl-rand-hex-16

# --- Social sign-in (server-side only; never prefix with NEXT_PUBLIC_). A provider's button appears only ---
# --- when both its ID and secret are set. Callback URL: {SITE_URL}/api/auth/callback/{google|github}.   ---
# Local development: set SITE_URL=http://localhost:3000 and BETTER_AUTH_SECRET (any 32+ random characters).
# In Kubernetes: scripts/set-oauth-config.sh. Setup steps: docs/AUTH.md.
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GITHUB_CLIENT_ID=replace-me
# GITHUB_CLIENT_SECRET=replace-me

# Avatar uploads (stored in R2 at jithendar/www/media/images/avatars/{user-id}/{id}.webp, re-encoded to 512 px WebP):
# AVATAR_MAX_BYTES=2097152          # upload size limit (64 KB – 10 MB)
# AVATAR_MAX_DIMENSION=4096         # largest accepted side in pixels
# AVATAR_MIN_DIMENSION=64           # smallest accepted side in pixels

# --- Email ------------------------------------------------------------------------------------------------
# Choose SMTP, Mailgun or Amazon SES in Admin → Storage & email (secrets are stored encrypted there).
# Until an admin saves a choice, this SMTP fallback is used when both are set (smtp:// or smtps:// only):
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Jithendar.com <no-reply@jithendar.com>
# Amazon SES with "the server's AWS credentials" uses the AWS SDK default chain, e.g.:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
