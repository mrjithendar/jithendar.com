# Dependencies, build output and local state (www/.gitignore adds Next.js specifics)
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
.data/
*.log

# Secrets: only the example is committed
.env
.env.*
!.env.example
.secrets
# Exported Kubernetes Secrets (e.g. kubectl get secret … -o yaml). Never commit these.
jithendar-com-env.yaml
jithendar-postgres.yaml
jithendar-redis.yaml
*.secret.yaml
*-secret.yaml

.DS_Store

# Python (executor/)
__pycache__/
.pytest_cache/
.venv/
executor/build/
*.egg-info/
infra/**/.terraform/
*.tfplan
*.tfstate
*.tfstate.*
