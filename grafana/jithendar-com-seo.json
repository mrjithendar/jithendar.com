        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Run duration p95",
      "description": "95th percentile over 1 h windows. Backfills run in ~4-minute slices.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(seo_sync_duration_seconds_bucket{job=\"jithendar-com\"}[1h])))",
          "legendFormat": "{{job_type}}"
