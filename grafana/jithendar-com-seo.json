    {
      "type": "timeseries",
      "title": "Runs by job type and outcome",
      "description": "Succeeded/partial vs failed runs. Skipped runs (locked, not configured) are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum by (job_type) (increase(seo_sync_success_total{job=\"jithendar-com\"}[$__interval]))",
          "legendFormat": "{{job_type}} ok"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum by (job_type, error_code) (increase(seo_sync_failure_total{job=\"jithendar-com\"}[$__interval]))",
          "legendFormat": "{{job_type}} failed ({{error_code}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
