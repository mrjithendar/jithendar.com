        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "max(seo_sync_consecutive_failures{job=\"jithendar-com\", job_type=\"gsc_sync\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
