              "status": "Status",
              "duration_ms": "Duration (ms)",
              "outcome": "Outcome",
              "trace_id": "Trace id"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Duration (ms)",
                "destinationType": "number"
              },
              {
                "targetField": "Status",
                "destinationType": "number"
              }
            ]
          }
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 0,
