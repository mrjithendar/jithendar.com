  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "roboshop-prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_total{job=\"jithendar-com\"}, route)",
          "refId": "route"
        },
        "definition": "label_values(http_server_requests_total{job=\"jithendar-com\"}, route)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "/^(?!/api/health$).*/"
      },
      {
        "name": "status",
        "label": "Status",
        "type": "custom",
        "query": "any : [0-9]+,2xx : 2..,3xx : 3..,4xx : 4..,5xx : 5..,4xx or 5xx : [45]..",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "any",
          "value": "[0-9]+"
        },
        "options": [
          {
            "text": "any",
            "value": "[0-9]+",
            "selected": true
          },
          {
            "text": "2xx",
            "value": "2..",
            "selected": false
          },
          {
            "text": "3xx",
            "value": "3..",
            "selected": false
          },
          {
            "text": "4xx",
            "value": "4..",
            "selected": false
          },
          {
            "text": "5xx",
            "value": "5..",
            "selected": false
          },
          {
            "text": "4xx or 5xx",
            "value": "[45]..",
            "selected": false
          }
        ]
      },
      {
        "name": "min_ms",
        "label": "Min duration (ms)",
        "type": "textbox",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        }
      },
      {
        "name": "trace_id",
        "label": "Trace id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "search",
        "label": "Logs contain",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Site restarts",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "roboshop-prometheus"
        },
        "expr": "changes(max(process_start_time_seconds{job=\"jithendar-com\"})[2m:30s]) > 0",
        "step": "60s",
        "titleFormat": "Site pod started"
      }
    ]
  },
