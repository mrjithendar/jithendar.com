      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "(sum(rate(http_server_requests_total{job=\"jithendar-com\", route!=\"/api/health\", route=~\"$route\", status=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_total{job=\"jithendar-com\", route!=\"/api/health\", route=~\"$route\"}[5m])), 1e-9)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
