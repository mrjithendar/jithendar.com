    "jithendar-com",
    "prometheus",
    "loki",
    "jaeger"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "id": null,
  "links": [
    {
      "title": "Jithendar.com · Observability",
      "type": "link",
      "url": "/grafana/d/jithendar-com-observability",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Jithendar.com · Overview",
      "type": "link",
      "url": "/grafana/d/jithendar-com-overview",
