    {
      "type": "table",
      "title": "Requests (newest first): click a trace id",
      "description": "One completion line per request (Loki, event=http_request_completed), filtered by Route, Status and Min duration. Click a trace id to show its trace and log lines below, or open it in Explore. Jaeger keeps only the newest 5000 traces in memory, so old ids may no longer resolve.",
      "datasource": {
        "type": "loki",
        "uid": "roboshop-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "{namespace=\"jithendar\", container=\"web\"} | logfmt | event=\"http_request_completed\" | route=~\"$route\" | status=~\"$status\" | duration_ms >= $min_ms",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show this trace below",
                    "url": "/grafana/d/jithendar-com-observability/jithendar-com-observability?${__url_time_range}&var-trace_id=${__value.raw}&${route:queryparam}&${status:queryparam}&${min_ms:queryparam}"
                  },
                  {
                    "title": "Open in Explore (Jaeger)",
                    "url": "",
                    "internal": {
                      "datasourceUid": "jaeger",
                      "datasourceName": "Jaeger",
                      "query": {
                        "query": "${__value.raw}"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration (ms)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 2000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 400
                    },
                    {
                      "color": "red",
                      "value": 500
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": false,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "Line": true,
              "tsNs": true,
              "id": true,
              "container": true,
              "namespace": true,
              "pod": true,
              "instance": true,
              "job": true,
              "level": true,
              "service_name": true,
              "detected_level": true,
              "event": true,
