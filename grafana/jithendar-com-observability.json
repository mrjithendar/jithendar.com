    {
      "type": "stat",
      "title": "Requests / s",
      "description": "Requests handled by Next.js for the selected routes, 5-minute rate (Prometheus).",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum(rate(http_server_requests_total{job=\"jithendar-com\", route!=\"/api/health\", route=~\"$route\"}[5m]))",
          "legendFormat": ""
