    {
      "type": "timeseries",
      "title": "Spans per second",
      "description": "Collector: received from the apps, filtered by the privacy rules, sent to Jaeger. Jaeger: stored. Refused or failed spans mean lost traces (alert TraceSpansLost).",
      "datasource": {
        "type": "prometheus",
        "uid": "roboshop-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum(rate({__name__=~\"otelcol_receiver_accepted_spans(_total)?\", job=\"otel-collector\"}[5m]))",
          "legendFormat": "collector received"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum(rate({__name__=~\"otelcol_exporter_sent_spans(_total)?\", job=\"otel-collector\"}[5m]))",
          "legendFormat": "collector sent"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum(rate({__name__=~\"otelcol_exporter_sent_spans(_total)?\", job=\"jaeger\"}[5m]))",
          "legendFormat": "Jaeger stored"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "roboshop-prometheus"
          },
          "expr": "sum by (job, reason) (label_replace(rate({__name__=~\"otelcol_receiver_refused_spans(_total)?\", job=~\"otel-collector|jaeger\"}[5m]), \"reason\", \"refused\", \"\", \"\") or label_replace(rate({__name__=~\"otelcol_receiver_failed_spans(_total)?\", job=~\"otel-collector|jaeger\"}[5m]), \"reason\", \"failed\", \"\", \"\") or label_replace(rate({__name__=~\"otelcol_exporter_send_failed_spans(_total)?\", job=~\"otel-collector|jaeger\"}[5m]), \"reason\", \"send_failed\", \"\", \"\")) > 0",
          "legendFormat": "lost ({{job}}, {{reason}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "lost.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 22,
      "gridPos": {
        "x": 0,
        "y": 78,
        "w": 12,
        "h": 7
      }
