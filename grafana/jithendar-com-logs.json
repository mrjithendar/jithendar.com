{
  "uid": "jithendar-com-logs",
  "title": "Jithendar.com \u00b7 Logs",
  "description": "Logs of the jithendar namespace from Loki. The collector keeps only allowlisted fields (event, level, route, method, status, error type, trace id); free text such as messages is dropped by design.",
  "tags": [
    "jithendar-com",
    "loki",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Jithendar.com · Observability",
