        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "sum by (level) (count_over_time({namespace=\"jithendar\", container=~\"$container\", level=~\"$level\"} [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
