      "id": 14,
      "type": "logs",
      "title": "Failed or slow requests (5xx or over 2 s)",
      "description": "Completion lines (event=http_request_completed). Each has trace_id; open the line to follow the Jaeger link.",
      "datasource": {
        "type": "loki",
        "uid": "roboshop-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "{namespace=\"jithendar\", container=\"web\"} | logfmt | event=\"http_request_completed\" | status >= 500 or duration_ms > 2000"
        }
