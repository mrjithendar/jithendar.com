    {
      "type": "table",
      "title": "Top events",
      "description": "`event` is a stable name for each kind of log line (e.g. comment_submitted, mail_send_failed).",
      "datasource": {
        "type": "loki",
        "uid": "roboshop-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "roboshop-loki"
          },
          "expr": "topk(25, sum by (event, level) (count_over_time({namespace=\"jithendar\", container=\"web\"} | logfmt [$__range])))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
