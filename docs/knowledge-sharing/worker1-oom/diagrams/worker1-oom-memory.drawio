          <mxGeometry x="735" y="172" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Measured at 11:10:15&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;worker1 working set 6.88 GiB (91%),&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;LiteLLM 1 alone 1.02 GiB.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;LiteLLM 2 started at 11:10:24; it was&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;never scraped, so 1.05 GiB is LiteLLM 1&amp;#x27;s.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="330" width="295" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b style=&quot;font-size:13px&quot;&gt;No memory eviction on the kubelet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;evictionHard: disk thresholds only.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;With no memory.available threshold,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;the kubelet never evicts for memory:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;the node thrashed instead.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="333" y="330" width="295" height="104" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Why worker1, twice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;The scheduler ranks nodes by requests.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;worker1 had the most unrequested&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;memory (69% requested at 10:25), and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;was already the most used (80%).&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
