        </mxCell>
        <mxCell id="r2" value="&lt;b style=&quot;font-size:13px&quot;&gt;ConfigMap argocd-rbac-cm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;a user without a role gets nothing;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;admin is role:admin built in&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="232" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&lt;b style=&quot;font-size:13px&quot;&gt;server · controller · repoServer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;replicas: 1 each; Service ClusterIP; no Ingress&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;requests 50m/128Mi, 100m/256Mi, 100m/256Mi&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
