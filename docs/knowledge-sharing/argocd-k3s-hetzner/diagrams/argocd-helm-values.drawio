          <mxGeometry x="520" y="472" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="&lt;b style=&quot;font-size:13px&quot;&gt;applicationSet: enabled: false&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;this chart has no such switch&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;(the key is ignored)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="552" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="&lt;b style=&quot;font-size:13px&quot;&gt;argocd-applicationset-controller&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;rendered anyway, and running&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;(no ApplicationSet exists)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="552" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="&lt;b style=&quot;font-size:13px&quot;&gt;extraObjects&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;rendered as they are, released with the&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;chart: one helm upgrade for everything&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="632" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="&lt;b style=&quot;font-size:13px&quot;&gt;VirtualService argocd&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;the /argocd delegate (two routes)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;NetworkPolicy istio-sidecars&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="632" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Terraform: global.podAnnotations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;checksum/redis = sha1(the Valkey password)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;a new password changes it&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="712" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Every pod rolls&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;when the password changes, so no pod keeps&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;a password Valkey no longer accepts&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="712" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Chart defaults we keep&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;crds.install, crds.keep: true&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;global.networkPolicy.create: true&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="792" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r9" value="&lt;b style=&quot;font-size:13px&quot;&gt;3 CRDs + 3 NetworkPolicies&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;CRDs keep on uninstall (resource-policy)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;ingress policies: server, repo-server, controller&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="792" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="Merge order: the chart's 4,951-line values.yaml, then our file, then Terraform's yamlencode() block. Rendered: 33,555 lines, 30,890 of them the three CRDs. Inspect with helm show values and helm template." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
