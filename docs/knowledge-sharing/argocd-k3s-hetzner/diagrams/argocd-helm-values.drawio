        </mxCell>
        <mxCell id="v1" value="&lt;b style=&quot;font-size:13px&quot;&gt;configs.params&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;server.insecure: true · server.rootpath: /argocd&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;server.basehref: /argocd · redis.db: &amp;quot;7&amp;quot;&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="152" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b style=&quot;font-size:13px&quot;&gt;ConfigMap argocd-cmd-params-cm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;read by every component as env vars; the chart adds&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;redis.server = valkey-master.redis...:6379&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
