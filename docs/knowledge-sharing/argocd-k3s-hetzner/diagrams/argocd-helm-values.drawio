        </mxCell>
        <mxCell id="v2" value="&lt;b style=&quot;font-size:13px&quot;&gt;configs.rbac&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;policy.default: &amp;#x27;&amp;#x27;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;(no default role for signed-in users)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
