        <mxCell id="heading" value="&lt;b&gt;https://jithendar.com/argocd: from the browser to argocd-server&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="12" width="920" height="24" as="geometry" />
        </mxCell>
        <mxCell id="you" value="&lt;b style=&quot;font-size:13px&quot;&gt;Browser or CLI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;jithendar.com/argocd&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;argocd --grpc-web&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="60" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cf" value="&lt;b style=&quot;font-size:13px&quot;&gt;Cloudflare (proxied)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;caches by URL alone,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;ignores cookies and Accept&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Rocket Loader rewrites HTML&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="210" y="60" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hetzner LB11 mk4-edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;TCP 80/443, PROXY protocol&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;to NodePorts 31080/31443&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="460" y="60" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="&lt;b style=&quot;font-size:13px&quot;&gt;istio-ingressgateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;TLS: *.jithendar.com (DNS-01)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;routing table, first match wins&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/argocd → delegate argocd/argocd&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="690" y="60" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Why two routes&lt;/b&gt;&lt;br&gt;Argo CD sends no Cache-Control on API GETs. A page request that does not accept text/html (curl, a probe) gets the file as built, with &amp;lt;base href=&quot;/&quot;&amp;gt;, or a 404. Cloudflare cached all of these by URL and served them to every browser." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="40" y="240" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b style=&quot;font-size:13px&quot;&gt;argocd-api: /argocd/api/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;response: cache-control&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;no-store, no-transform&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;commits fe3efdd, 1f76443&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="330" y="240" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b style=&quot;font-size:13px&quot;&gt;argocd: everything else&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;request: accept: text/html&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;response: adds no-transform&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;8f5eb06, 6f93d92, 1f76443&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="640" y="240" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="srv" value="&lt;b style=&quot;font-size:13px&quot;&gt;argocd-server :80&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;plain HTTP inside the mesh (server.insecure)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;serves under /argocd itself (rootpath, basehref): never strip the prefix&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;UI, REST API and gRPC-web&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="330" y="360" width="600" height="95" as="geometry" />
        </mxCell>
        <mxCell id="fixes" value="&lt;b&gt;Fixed on 19 November 2026, Helm revisions 3 to 6:&lt;/b&gt; a cached /argocd/ with the wrong base (blank page), a cached signed-out userinfo (login loop) and a signed-in /api/v1/clusters served to anyone, a curl's cached 404 for /argocd/applications, and Rocket Loader holding back main.js (blank page)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="485" width="920" height="36" as="geometry" />
