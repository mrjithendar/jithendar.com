        <mxCell id="heading" value="&lt;b&gt;The moks workflow: 12 jobs and the needs between them (ci.yml on master)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
