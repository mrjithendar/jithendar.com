        </mxCell>
        <mxCell id="rri" value="&lt;b style=&quot;font-size:13px&quot;&gt;reranker-image  ·  2 min&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;offline smoke test, push&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;moks-reranker:latest&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="261" width="250" height="74" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="&lt;b style=&quot;font-size:13px&quot;&gt;embedder-image  ·  2 min&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;real /embed, unit length,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;push moks-embedder:latest&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="349" width="250" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ti" value="&lt;b style=&quot;font-size:13px&quot;&gt;terminal-image  ·  2 min&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;needs nothing: arm64 + amd64,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;push moks-terminal:latest&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="520" y="437" width="250" height="74" as="geometry" />
        </mxCell>
        <mxCell id="dep" value="&lt;b style=&quot;font-size:13px&quot;&gt;deploy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;needs release (success)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;and release-crewai (any)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Argo CD sync + restart&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;skipped in all 22 runs&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="830" y="85" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="harbor" value="&lt;b&gt;Every push job&lt;/b&gt; logs in to Harbor (registry.jithendar.com, project jithendar) with a robot account, pushes one tag, latest, and uploads a release record: commit, digest, run." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="815" y="270" width="205" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="&lt;b&gt;Nothing waits on image, e2e or terminal.&lt;/b&gt; On master they report and stop nothing: run #245 released with both terminal jobs red, and run #257 pushed moks-terminal:latest while the terminal scan had failed on a HIGH CVE in the same image." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
