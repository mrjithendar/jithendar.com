<mxfile host="app.diagrams.net" agent="build_diagrams.py" version="24.7.17" type="device">
  <diagram id="deploy-server-release-0" name="Release on one server">
    <mxGraphModel dx="800" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="330" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b" value="1. Build the image&#10;tag: git commit SHA&#10;linux/arm64 or amd64" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="10" y="60" width="168" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p" value="2. Push it&#10;GHCR or ECR&#10;keep old tags" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="188" y="60" width="168" height="74" as="geometry" />
        </mxCell>
        <mxCell id="u" value="3. compose up -d&#10;IMAGE=...:&lt;new sha&gt;&#10;web is replaced" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="366" y="60" width="168" height="74" as="geometry" />
        </mxCell>
        <mxCell id="m" value="4. Migrations run&#10;on start, under a&#10;pg advisory lock" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#451a03;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="544" y="60" width="168" height="74" as="geometry" />
        </mxCell>
        <mxCell id="h" value="5. Health check&#10;GET /api/health&#10;status ok + version" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="722" y="60" width="168" height="74" as="geometry" />
        </mxCell>
        <mxCell id="rb" value="Roll back&#10;IMAGE=...:&lt;old sha&gt;&#10;compose up -d again" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fef2f2;strokeColor=#b91c1c;fontColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="722" y="200" width="168" height="74" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="The web container restarts, so a release on one server costs a few seconds of 502s." style="text=1;html=0;align=left;verticalAlign=top;resizable=1;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1">
          <mxGeometry x="10" y="210" width="557.7600000000001" height="17" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="Migrations only move forward: the previous image must still run on the new schema." style="text=1;html=0;align=left;verticalAlign=top;resizable=1;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1">
          <mxGeometry x="10" y="232" width="551.0400000000001" height="17" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Postgres and Caddy keep running; only the web container changes." style="text=1;html=0;align=left;verticalAlign=top;resizable=1;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1">
          <mxGeometry x="10" y="254" width="430.08000000000004" height="17" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#475569;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b" target="p">
          <mxGeometry x="0.0" y="0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#475569;strokeWidth=1.6;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p" target="u">
