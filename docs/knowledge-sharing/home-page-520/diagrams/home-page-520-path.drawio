          <mxGeometry x="622" y="85" width="130" height="96" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b style=&quot;font-size:13px&quot;&gt;web: Next.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;ISR page cache,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;2 pods, warm-up&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;of 91 pages&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="772" y="85" width="156" height="96" as="geometry" />
        </mxCell>
        <mxCell id="fail1" value="1" style="ellipse;html=1;fillColor=#b91c1c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="392" y="77" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c-cf" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Through Cloudflare&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;GET /  →  520, 502 or time-out&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;HEAD /  →  200 (not cached)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;GET /?a=1 and GET /?  →  200&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;GET /blog, /privacy-policy  →  200&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;after the purge: GET /  →  200, HIT&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="250" width="290" height="132" as="geometry" />
        </mxCell>
        <mxCell id="c-gw" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. At the origin, no Cloudflare&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;curl --resolve to the gateway&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;GET /  →  200, 174 KB, about 1 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;IPv4 and IPv6; HTTP/1.1 and HTTP/2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;identity, gzip, br and zstd: 200&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="335" y="250" width="290" height="132" as="geometry" />
        </mxCell>
        <mxCell id="c-pod" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. At the pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;port-forward: GET /  →  200 in 1.3 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;request log: Cloudflare&amp;#x27;s tagged&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;GET / answered 200 in 3 ms, while&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;the client got no answer at all&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;warm-up after a start: 52 to 54 s&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="650" y="250" width="290" height="132" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="&lt;b style=&quot;font-size:13px&quot;&gt;Fix: purge https://jithendar.com/ from Cloudflare&amp;#x27;s cache (Admin → Cache)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;No code, pod or gateway change. The same URL answered 200 within a minute and was cached again.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="420" width="920" height="56" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Only one cache key was broken.&lt;/b&gt; The pod, the gateway and the page itself were fine; the same page under another key (a query string, or a HEAD request, which Cloudflare does not cache) worked throughout." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
