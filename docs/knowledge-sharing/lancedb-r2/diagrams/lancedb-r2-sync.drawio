          <mxGeometry x="0.0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="heading" value="&lt;b&gt;How the copy is written, and how it drifted from Postgres in its first week&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="12" width="920" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. reindex_flow finishes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;weekly, Sunday 03:17 UTC, or one article&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;from publish_flow (approved AI drafts)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="82" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Did anything change?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;embedded, reused, deleted or swapped &amp;gt; 0;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;if not, write only when the table is missing&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="168" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Read pgvector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;the published articles&amp;#x27; chunks with the&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;vectors Postgres already holds (no re-embed)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="254" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Guards&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;an empty result keeps the existing copy;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;mixed vector sizes are refused&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="340" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. create_table(mode=&amp;quot;overwrite&amp;quot;)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;the whole table written as one new version,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;under the agent&amp;#x27;s reindex lock&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="426" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. optimize(cleanup_older_than=1 h)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;older versions removed; a failed sync is a&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;warning and the reindex still succeeds&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="512" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="&lt;b style=&quot;font-size:13px&quot;&gt;15 Nov, 03:17: weekly reindex&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;52 articles, 2,514 chunks embedded&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;(before the LanceDB copy existed)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="505" y="82" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;b style=&quot;font-size:13px&quot;&gt;22 Nov, 03:17 to 03:23: weekly reindex&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;68 articles: 671 embedded, 2,508 unchanged;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;copy rewritten as version 2, 3,179 rows&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="505" y="168" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b style=&quot;font-size:13px&quot;&gt;After the sync: one article deleted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;its 32 chunks left pgvector with the post,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;but stay in the copy: no reindex ran&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="505" y="254" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b style=&quot;font-size:13px&quot;&gt;23 Nov: two articles published by hand&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Admin → Posts does not start a reindex:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;no chunks in pgvector or in LanceDB&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="505" y="340" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b style=&quot;font-size:13px&quot;&gt;24 Nov: the two stores differ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;pgvector: 3,147 chunks from 67 articles&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;LanceDB: 3,179 chunks from 68 articles&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="505" y="426" width="420" height="76" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;b style=&quot;font-size:13px&quot;&gt;29 Nov, 03:17: next weekly reindex&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;embeds the two new articles, so the copy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;is rewritten and matches Postgres again&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="505" y="512" width="420" height="76" as="geometry" />
        </mxCell>
