<mxfile host="app.diagrams.net" agent="build_diagrams.py" version="24.7.17" type="device">
  <diagram id="lets-encrypt-k3s-renewal-0" name="Automatic renewal">
    <mxGraphModel dx="800" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="520" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="z0" value="cert-manager decides" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#94a3b8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=1;whiteSpace=wrap;html=0;" vertex="1" parent="1">
          <mxGeometry x="15" y="12" width="870" height="130" as="geometry" />
        </mxCell>
        <mxCell id="z1" value="ACME DNS-01 round trip" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#94a3b8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=1;whiteSpace=wrap;html=0;" vertex="1" parent="1">
          <mxGeometry x="15" y="158" width="870" height="130" as="geometry" />
        </mxCell>
        <mxCell id="z2" value="Result" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#94a3b8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=1;whiteSpace=wrap;html=0;" vertex="1" parent="1">
          <mxGeometry x="15" y="304" width="870" height="204" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="1. Certificate Ready&#10;status.renewalTime set at&#10;2/3 of the lifetime (day 60 of 90)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="due" value="2. Renewal time passes&#10;condition Issuing = True&#10;no cron job, no human" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="40" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="csr" value="3. New key + CertificateRequest&#10;rotationPolicy Always by default&#10;since cert-manager v1.18" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="order" value="4. Order + DNS-01 Challenge&#10;one authorization per name" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#6d28d9;fontColor=#2e1065;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="186" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="txt" value="5. TXT record via Cloudflare API&#10;self-check over DNS over HTTPS&#10;(pods cannot reach port 53)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#6d28d9;fontColor=#2e1065;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="186" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="le" value="6. Let's Encrypt validates&#10;looks up the TXT record&#10;signs the certificate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="186" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="secret" value="7. Secret updated in place&#10;same name, new tls.crt + tls.key" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#451a03;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="332" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="8. Istio gateway reloads&#10;Envoy gets the Secret over SDS&#10;no pod restart" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eef2ff;strokeColor=#4338ca;fontColor=#1e1b4b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="315" y="332" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="If a step fails&#10;retry: 1 h, doubling up to 32 h&#10;old certificate still valid ~30 days" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fef2f2;strokeColor=#b91c1c;fontColor=#7f1d1d;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="332" width="270" height="88" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="The loop restarts with the new certificate. With 45-day certificates the same rule renews on day 30." style="text=1;html=0;align=left;verticalAlign=top;resizable=1;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="452" width="672.0000000000001" height="17" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="Nothing in the Certificate sets renewBefore, so the timing follows whatever lifetime Let's Encrypt issues." style="text=1;html=0;align=left;verticalAlign=top;resizable=1;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="474" width="712.32" height="17" as="geometry" />
        </mxCell>
