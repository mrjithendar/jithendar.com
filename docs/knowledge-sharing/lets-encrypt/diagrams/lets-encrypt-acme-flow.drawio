        </mxCell>
        <mxCell id="z1" value="Let's Encrypt (ACME server)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#94a3b8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;fontFamily=Helvetica;fontSize=12;fontColor=#475569;fontStyle=1;whiteSpace=wrap;html=0;" vertex="1" parent="1">
          <mxGeometry x="465" y="12" width="420" height="536" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="1. Register an account&#10;account key pair signs every request" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="2. Create an order&#10;names: example.com, www.example.com" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="142" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="4. Publish the proof&#10;HTTP path or DNS TXT record" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#6d28d9;fontColor=#2e1065;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="244" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="6. Finalize with a CSR&#10;certificate private key stays here" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#ecfdf5;strokeColor=#047857;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="346" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="8. Install certificate + chain&#10;reload the server; renew = repeat" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#451a03;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="448" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Account stored&#10;public key only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="3. Return challenges&#10;one random token per name" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="142" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="5. Validate&#10;fetches the proof from several networks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#1d4ed8;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="244" width="390" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="7. Sign the certificate&#10;logged to Certificate Transparency" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
