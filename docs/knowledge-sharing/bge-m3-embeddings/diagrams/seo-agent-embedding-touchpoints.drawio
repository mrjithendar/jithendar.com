        <mxCell id="heading" value="&lt;b&gt;What one embeddings setting touches in seo-agent&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="12" width="920" height="24" as="geometry" />
        </mxCell>
        <mxCell id="prov" value="&lt;b style=&quot;font-size:13px&quot;&gt;EMBEDDINGS_PROVIDER + model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;today: onnx, bge-small in the image, 384-d&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;next: ollama, bge-m3 on mk4, 1024-d&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;cutoffs: app/calibration.py, one row per model&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="280" y="55" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="chunks" value="&lt;b style=&quot;font-size:13px&quot;&gt;seo_article_chunks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;vector(384) today;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;builds _next at 1024,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;then swaps it in&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="220" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="floor" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ask floor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;bge-small 0.66 (measured)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;bge-m3 0.52 (interim)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;ASK_BLOG_MIN_SCORE wins&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
