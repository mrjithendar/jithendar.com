        <mxCell id="heading" value="&lt;b&gt;bge-m3 on mk4: one Ollama pod, pinned weights, two allowed callers&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="12" width="920" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tf" value="&lt;b style=&quot;font-size:13px&quot;&gt;embeddings.tf (Terraform)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;helm_release bge-m3,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;local chart, timeout ≥ 1200 s&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="70" width="220" height="72" as="geometry" />
        </mxCell>
        <mxCell id="reg" value="&lt;b style=&quot;font-size:13px&quot;&gt;registry.ollama.ai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;bge-m3:567m, F16, 1.16 GB&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;HTTPS, public addresses only&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="190" width="220" height="72" as="geometry" />
        </mxCell>
        <mxCell id="init" value="&lt;b style=&quot;font-size:13px&quot;&gt;init: fetch-model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;pull once onto the volume&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;refuse any other digest&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;skip when already there&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="305" y="80" width="205" height="88" as="geometry" />
        </mxCell>
        <mxCell id="pvc" value="&lt;b style=&quot;font-size:13px&quot;&gt;Model volume&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;hcloud, 10 Gi&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;policy: keep&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="530" y="80" width="140" height="88" as="geometry" />
        </mxCell>
        <mxCell id="oll" value="&lt;b style=&quot;font-size:13px&quot;&gt;ollama serve 0.40.16 (pinned digest)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;keep-alive -1: the model stays loaded&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;context 2048 tokens, longer input truncated&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;one request at a time (-np 1)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;1.5 GiB request, 2.5 GiB limit, no CPU limit&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="305" y="195" width="365" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pol" value="&lt;b style=&quot;font-size:13px&quot;&gt;Two policies&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;NetworkPolicy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;AuthorizationPolicy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;enforced, not dry run&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="305" y="335" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="&lt;b style=&quot;font-size:13px&quot;&gt;Service :11434&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;bge-m3.embeddings&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/api/embed&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/v1/embeddings&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="335" width="175" height="90" as="geometry" />
        </mxCell>
        <mxCell id="other" value="&lt;b style=&quot;font-size:13px&quot;&gt;Any other pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;e.g. moks executor, terminal&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;refused by both policies&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
