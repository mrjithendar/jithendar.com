        </mxCell>
        <mxCell id="moks" value="&lt;b style=&quot;font-size:13px&quot;&gt;moks api, worker, crewai&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;ns moks · sa moks&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="720" y="380" width="220" height="64" as="geometry" />
        </mxCell>
        <mxCell id="meas" value="&lt;b&gt;Measured on mk4 (Hetzner cax21: 4 arm64 cores, 8 GiB)&lt;/b&gt;&lt;br&gt;1024 dimensions, L2-normalised, no prefix&lt;br&gt;cold load 5 s; one warm query about 650 ms&lt;br&gt;about 0.7 chunks/s; a batch of 32 takes about 45 s&lt;br&gt;about 1.3 GiB resident; about 3.5 of 4 cores while embedding" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="475" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Why Ollama and not Hugging Face TEI&lt;/b&gt;&lt;br&gt;TEI publishes CPU images for amd64 only, and mk4's nodes are arm64.&lt;br&gt;Ollama serves bge-m3's dense vectors only, not its sparse or multi-vector output: both callers keep keyword search in PostgreSQL.&lt;br&gt;OLLAMA_NUM_PARALLEL is 2, but the runner embeds with -np 1." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="490" y="475" width="450" height="110" as="geometry" />
