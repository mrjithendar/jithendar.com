        <mxCell id="api2" value="&lt;b style=&quot;font-size:13px&quot;&gt;moks api + worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;same code, the PostgresBackend&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="510" y="85" width="410" height="64" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b style=&quot;font-size:13px&quot;&gt;bge-m3 (shared)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;question → 1024-d vector&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;one call at a time,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;waits 2 s for the slot,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;else keyword-only&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="510" y="185" width="195" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pg2" value="&lt;b style=&quot;font-size:13px&quot;&gt;PostgreSQL (CNPG)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;tsvector keyword&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;identifier match&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;pgvector k-NN (&amp;lt;=&amp;gt;)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="725" y="185" width="195" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rrf" value="&lt;b style=&quot;font-size:13px&quot;&gt;Fused in moks: RRF (k = 60)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;keyword + identifier + vector rankings,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;then the access check on every chunk,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;then optional reranking&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="510" y="330" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="&lt;b&gt;Memory requests:&lt;/b&gt; OpenSearch 2 GiB + Dashboards 512 Mi go; bge-m3 1.5 GiB comes, shared with seo-agent. &lt;b&gt;Index:&lt;/b&gt; 730 chunks. On mk4 OpenSearch only ever held a keyword-only index (no embedding model was active), so the move also adds vector search for the first time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#334155;spacing=0;" parent="1" vertex="1">
