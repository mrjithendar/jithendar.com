        </mxCell>
        <mxCell id="os" value="&lt;b style=&quot;font-size:13px&quot;&gt;moks-opensearch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;BM25 keyword index&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;no vectors: keyword-only&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;2 GiB requested&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;20 Gi PV on worker2&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;spacingTop=10;" parent="1" vertex="1">
