        <mxCell id="rebuild" value="&lt;b style=&quot;font-size:13px&quot;&gt;Rebuild index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Knowledge → Rebuild index, or moks reindex&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;730 chunks at about 0.7 chunks/s: about 17 minutes&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;adds the vector column; keyword-only until then&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
