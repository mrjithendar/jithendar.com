        </mxCell>
        <mxCell id="r0" value="&lt;b style=&quot;font-size:13px&quot;&gt;Before: runners as systemd services on the old Minikube host&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Builds competed with the cluster for memory and disk and froze the host twice. CI went back to GitHub-hosted runners.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="130" y="60" width="810" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;05:12&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="138" width="70" height="18" as="geometry" />
