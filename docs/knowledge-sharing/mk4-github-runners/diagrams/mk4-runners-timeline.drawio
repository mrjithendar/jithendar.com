        <mxCell id="fail1" value="1" style="ellipse;html=1;fillColor=#b91c1c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="90" y="136" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b style=&quot;font-size:13px&quot;&gt;PR #24 merged (a9cd274): ARC 0.15.1, scale set mk4, runners.tf, NetworkPolicy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Deploy stops at Check CI settings: Not set: TF_VAR_github_runners_app_*. Fix: create the GitHub App, set 3 secrets.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="130" y="122" width="810" height="52" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;06:02&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="200" width="70" height="18" as="geometry" />
        </mxCell>
        <mxCell id="fail2" value="2" style="ellipse;html=1;fillColor=#b91c1c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="90" y="198" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b style=&quot;font-size:13px&quot;&gt;CI cannot apply: Could not assume role with OIDC (the org rename broke the trust)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Fix for now: terraform apply -target=helm_release.arc_runners from a laptop. Listener Running at 06:02.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="130" y="184" width="810" height="52" as="geometry" />
