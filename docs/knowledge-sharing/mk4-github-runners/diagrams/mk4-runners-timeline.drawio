        <mxCell id="r8" value="&lt;b style=&quot;font-size:13px&quot;&gt;attempt 3 passes in 44 s on pod mk4-runner-z2k2l&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;07:02 moks-cms hygiene (docker run promtool) passes; 07:03 roboshop&amp;#x27;s services: mongo:8.0 starts and answers.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
