        </mxCell>
        <mxCell id="r6" value="&lt;b style=&quot;font-size:13px&quot;&gt;attempt 2: failed to connect to the docker API at unix:///var/run/docker.sock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;24 of the 52 jobs need a Docker daemon: docker build/run, docker/* actions, kind, services:, container actions.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
