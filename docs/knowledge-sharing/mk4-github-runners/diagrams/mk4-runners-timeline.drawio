        </mxCell>
        <mxCell id="r4" value="&lt;b style=&quot;font-size:13px&quot;&gt;jithendar.com content, attempt 1: Unable to locate executable file: git-lfs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;GitHub&amp;#x27;s actions-runner image is not ubuntu-latest: no git-lfs, shellcheck, gh, kubectl, helm, Docker daemon.&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
