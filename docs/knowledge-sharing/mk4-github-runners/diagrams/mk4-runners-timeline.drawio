        <mxCell id="fail3" value="3" style="ellipse;html=1;fillColor=#b91c1c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
