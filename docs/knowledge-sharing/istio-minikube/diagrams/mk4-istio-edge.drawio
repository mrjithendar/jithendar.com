        </mxCell>
        <mxCell id="haproxy" value="&lt;b style=&quot;font-size:13px&quot;&gt;HAProxy :80 / :443&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;TCP only, adds PROXY protocol v2&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
