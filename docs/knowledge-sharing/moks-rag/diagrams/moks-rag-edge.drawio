        </mxCell>
        <mxCell id="browser" value="&lt;b style=&quot;font-size:13px&quot;&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/chat&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="30" y="85" width="145" height="60" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b style=&quot;font-size:13px&quot;&gt;Service client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/rag + Bearer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;+ X-Service-Name&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="30" y="175" width="145" height="76" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b style=&quot;font-size:13px&quot;&gt;Site cache rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;caches responses&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;with no&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Cache-Control&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;for an hour&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="215" y="85" width="160" height="124" as="geometry" />
        </mxCell>
        <mxCell id="root" value="&lt;b style=&quot;font-size:13px&quot;&gt;Root VirtualService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;jithendar-com, istio-ingress&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/rag  → rag/rag-api&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/chat → rag/open-webui&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="440" y="85" width="215" height="92" as="geometry" />
        </mxCell>
        <mxCell id="vs-rag" value="&lt;b style=&quot;font-size:13px&quot;&gt;VirtualService rag-api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/rag/ and /rag → rewrite /&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="440" y="215" width="215" height="76" as="geometry" />
        </mxCell>
        <mxCell id="vs-ui" value="&lt;b style=&quot;font-size:13px&quot;&gt;VirtualService&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;open-webui&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/chat → 308 /chat/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/chat/ → rewrite /&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;no timeout: SSE, WebSocket&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="440" y="320" width="215" height="108" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b style=&quot;font-size:13px&quot;&gt;rag-api :8000&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;token checked in the app;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/health, /docs and&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;/openapi.json are open&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="700" y="85" width="265" height="92" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b style=&quot;font-size:13px&quot;&gt;open-webui :8080&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;SvelteKit build patched at&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;start-up for /chat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;one admin, signup off&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="700" y="195" width="265" height="92" as="geometry" />
        </mxCell>
        <mxCell id="pol" value="&lt;b style=&quot;font-size:13px&quot;&gt;AuthorizationPolicies&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;rag-api ← istio-ingress, rag,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;moks-sre, jithendar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;open-webui ← istio-ingress&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;qdrant, docling, litellm ← rag&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;bge-m3 ← 3 service accounts&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;everything else: denied&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="700" y="305" width="265" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fail1" value="1" style="ellipse;html=1;fillColor=#b91c1c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="363" y="88" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="&lt;b style=&quot;font-size:13px&quot;&gt;Next: chat.jithendar.com&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;its own origin: no patched bundle,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;its own cookies and localStorage,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;its own cache rule (bypass), and /chat&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;a redirect, like /harbor → registry&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacing=4;spacingLeft=6;rounded=1;arcSize=10;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="20" y="295" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;1 · Found on 26 November:&lt;/b&gt; Cloudflare returned /rag/health, /rag/openapi.json and Open WebUI's /chat/api/config from its cache (HIT, max-age 3600). The cached config was 32 minutes old and still said onboarding: true, though the admin account existed. Responses marked no-store (the auth endpoints) bypass the cache." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
