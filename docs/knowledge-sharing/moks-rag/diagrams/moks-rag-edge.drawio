        <mxCell id="heading" value="&lt;b&gt;From the internet to rag-api and Open WebUI: who checks what, and why chat needs its own host&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
