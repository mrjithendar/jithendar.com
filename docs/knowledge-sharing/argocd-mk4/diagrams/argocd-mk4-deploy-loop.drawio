        <mxCell id="a3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Render&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;helm template or&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;kustomize build&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
