        <mxCell id="heading" value="&lt;b&gt;How the primary moves, and what keeps writes flowing&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="12" width="920" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Primary told to stop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;SIGTERM, then preStop hook&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="78" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hand over first&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;SENTINEL FAILOVER mk4&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;waits for a new primary&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="250" y="78" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Primary goes silent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;crash, OOM, node lost&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="198" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sentinels agree&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;no answer for 5 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;2 of 3 mark it down&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="250" y="198" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Replica promoted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;leader Sentinel picks one&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;REPLICAOF NO ONE&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="490" y="138" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b style=&quot;font-size:13px&quot;&gt;HAProxy follows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;health check role:master&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;valkey-master: same address&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="730" y="138" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b style=&quot;font-size:13px&quot;&gt;What clients see&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;a few failed writes&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;2 in about 4 s (9 Nov test)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="490" y="250" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Old pod back as replica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;same node, same volume&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;resyncs from new primary&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="730" y="250" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b style=&quot;font-size:13px&quot;&gt;PDB minAvailable 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;a drain never breaks quorum&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="390" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Grace period 60 s&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;room for preStop failover&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="263" y="390" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Envoy outlives Valkey&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;starts first, drains 45 s&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="491" y="390" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="&lt;b style=&quot;font-size:13px&quot;&gt;down-after 5000 ms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;no failover on a blip&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="719" y="390" width="215" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="A planned stop hands the primary over before Valkey exits, so writes pause for about a second. An unplanned loss waits 5 s for Sentinel to be sure, then elects. Either way the pod comes back on its own node (local-path volumes are pinned) and rejoins as a replica; a node gone for good needs its PVC deleted." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="482" width="920" height="48" as="geometry" />
        </mxCell>
