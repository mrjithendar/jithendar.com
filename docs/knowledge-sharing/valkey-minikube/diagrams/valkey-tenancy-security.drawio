        </mxCell>
        <mxCell id="tfvars" value="&lt;b style=&quot;font-size:13px&quot;&gt;vars/mk4.tfvars: redis_tenants&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;practice → ns jithendar, db 1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;harbor → ns harbor, db 2-5&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;roboshop → ns roboshop-ai, db 6&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="78" width="360" height="92" as="geometry" />
        </mxCell>
        <mxCell id="tf" value="&lt;b style=&quot;font-size:13px&quot;&gt;redis.tf, per tenant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;random_password (encrypted state)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;validations: names, 0-31, no shared db&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="200" width="360" height="76" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b style=&quot;font-size:13px&quot;&gt;ACL user line in valkey.conf&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;user practice on #&amp;lt;sha256&amp;gt; ... db=1&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="306" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Secret jithendar/redis-practice-credentials&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;host, port, username, password, db, uri&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="380" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Namespace added to the policies&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;AuthorizationPolicy + NetworkPolicy&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="454" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="&lt;b style=&quot;font-size:13px&quot;&gt;checksum/acl pod annotation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;rolls the StatefulSet, primary hands over&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="35" y="528" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tf-note" value="The server stores only SHA-256 hashes. Removing a tenant deletes its user and Secret; its keys stay until flushed by hand." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="35" y="600" width="370" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b style=&quot;font-size:13px&quot;&gt;practice dispatcher (ns jithendar)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;EXECUTOR_REDIS_URL = uri&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="78" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Egress NetworkPolicy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;to the Valkey pods on 6379 and 6380&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="150" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Istio mTLS (STRICT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;sidecar identity: namespace jithendar&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="222" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. AuthorizationPolicy valkey (ALLOW)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;namespace listed? else the sidecar resets&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="294" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l5" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Ingress NetworkPolicy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;same namespaces, same ports&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="366" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l6" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. HAProxy behind valkey-master&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;forwards to the current primary&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="438" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l7" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. Valkey ACL: user practice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;db=1 · -@admin -flushall -swapdb&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="510" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="l8" value="&lt;b style=&quot;font-size:13px&quot;&gt;database 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;the practice queue (no TTL, never evicted)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="495" y="582" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Layers 2-4 refuse a connection before a single Redis byte reaches Valkey. Pub/Sub channels are not isolated by database: every user shares one channel namespace." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#334155;spacing=0;" parent="1" vertex="1">
