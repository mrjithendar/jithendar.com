        </mxCell>
        <mxCell id="cust" value="&lt;b style=&quot;font-size:13px&quot;&gt;Customers are not on the system&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;they phone, post a mail-order form or visit a store&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;" parent="1" vertex="1">
