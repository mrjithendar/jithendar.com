        <mxCell id="heading" value="&lt;b&gt;How a dashboard in Git becomes a dashboard in Grafana, in the right org and folder&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
