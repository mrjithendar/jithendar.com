        </mxCell>
        <mxCell id="why" value="If the slot were freed when the search stops waiting, every timeout would let new work start while the old call still holds the pod's one CPU, and each search would get slower than the last. Here the slot follows the computation, so at most the limit's worth of work runs at once." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#334155;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="522" y="492" width="405" height="90" as="geometry" />
