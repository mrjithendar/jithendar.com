        </mxCell>
        <mxCell id="m1" value="&lt;b style=&quot;font-size:13px&quot;&gt;master1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;tainted, so not a&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;spread domain&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;(nodeTaintsPolicy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Honor)&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;rounded=1;arcSize=10;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="740" y="86" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b style=&quot;font-size:13px&quot;&gt;PgBouncer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;session mode&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;2 poolers × 20 = 40&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;8 pods × 5 = 40&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;so at most 8 pods&lt;/span&gt;" style="whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingLeft=2;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="740" y="210" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Why pod 3 would wait.&lt;/b&gt; The Deployment spreads its pods so that no node has more than one pod more than another, and a pod that can't keep to that stays Pending (DoNotSchedule). With one pod on worker1 and one on worker2, a third may only start on worker3, and worker3 has 489Mi of memory requests left against the 512Mi a pod asks for. Until someone frees about 25Mi there, or relaxes the rule to ScheduleAnyway, the HPA can ask for 3 pods and the site keeps running 2." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="358" width="920" height="80" as="geometry" />
        </mxCell>
        <mxCell id="why-db" value="&lt;b&gt;Why 8 is the ceiling.&lt;/b&gt; Each pod opens up to 5 database connections (DATABASE_POOL_MAX), and PgBouncer in session mode holds one server connection per client: 8 pods use all 40." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0f172a;spacing=0;" parent="1" vertex="1">
          <mxGeometry x="20" y="440" width="920" height="40" as="geometry" />
        </mxCell>
