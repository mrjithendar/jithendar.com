# syntax=docker/dockerfile:1
# Content image of jithendar.com: everything that is this site and not the CMS. content/ (MDX), public/images/
# (diagrams, screenshots), and site.json with config/ (identity, redirects, 410s, the /hire-me profile). No Node, no
# build. Built and pushed by .github/workflows/content.yml as registry.jithendar.com/jithendar/jithendar-com-content:latest.
#
# The site Deployment (kubernetes/30-jithendar-com.yaml) runs the moks-cms image and this one as init container
# "content", which copies the three folders into emptyDirs mounted at /app/content, /app/public/images and /app/site in
# the web container. moks-cms reads all of them at run time, so a change here ships with a restart, never a build.
# busybox only provides `cp`.
#
#   docker build --platform linux/arm64 -f Dockerfile.content -t jithendar-com-content .     (from the repository root)
FROM busybox:1.38.0
COPY --chown=1000:1000 content /content
COPY --chown=1000:1000 public/images /images
COPY --chown=1000:1000 site.json /site/site.json
COPY --chown=1000:1000 config /site/config
USER 1000:1000
# cp -R, not cp -a: -a also tries to copy owner, mode and times onto the target directory itself (the mount point),
# which user 1000 may not change ("can't preserve … Operation not permitted"). The files are 1000:1000 either way and
# the site never reads their times (only sizes). The Deployment sets the same command; /mnt/site is copied only where
# it is mounted.
CMD ["sh", "-c", "cp -R /content/. /mnt/content/ && cp -R /images/. /mnt/images/ && { [ ! -d /mnt/site ] || cp -R /site/. /mnt/site/; }"]
