{
  "$id": "https://moks.dev/schemas/crewconfig/2/task.schema.json",
  "title": "task",
  "description": "Front matter of tasks/<crew>/<task>.md; the body is the instructions.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "crew": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$"
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "expected_output": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "context": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,39}$"
      }
    },
    "variables": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      }
    },
    "contract": {
      "type": "string",
      "maxLength": 8000
    },
    "output_editable": {
      "type": "boolean"
    }
  },
  "required": [
    "crew",
    "key",
    "agent",
    "label",
    "expected_output"
  ],
  "additionalProperties": false
}
