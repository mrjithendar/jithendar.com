{
  "$id": "https://moks.dev/schemas/crewconfig/2/manifest.schema.json",
  "title": "manifest",
  "description": "manifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "moks-crewai-bundle"
    },
    "format": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "min_format": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generator": {
      "type": "string",
      "maxLength": 100
    },
    "exported_at": {
      "type": "string",
      "maxLength": 40
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "app": {
      "type": "object",
      "properties": {
        "cms": {
          "type": "string",
          "maxLength": 100
        },
        "agent": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "checksum": {
      "type": "string",
      "maxLength": 64
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "inventory": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "compatibility": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "component",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "format"
  ],
  "additionalProperties": false
}
