{
  "$id": "https://moks.dev/schemas/crewconfig/2/providers.schema.json",
  "title": "providers",
  "description": "providers/providers.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 60
          },
          "kind": {
            "type": "string",
            "maxLength": 60
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "enabled": {
            "type": "boolean"
          },
          "base_url": {
            "type": "string",
            "maxLength": 500
          },
          "region": {
            "type": "string",
            "maxLength": 60
          },
          "deployment": {
            "type": "string",
            "maxLength": 120
          },
          "api_version": {
            "type": "string",
            "maxLength": 60
          },
          "key": {
            "type": "string",
            "enum": [
              "saved",
              "env",
              "none",
              "not_needed"
            ]
          },
          "key_ref": {
            "type": "string",
            "maxLength": 200
          },
          "models": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model_id": {
                  "type": "string",
                  "maxLength": 120
                },
                "label": {
                  "type": "string",
                  "maxLength": 120
                },
                "enabled": {
                  "type": "boolean"
                },
                "free": {
                  "type": "boolean"
                },
                "price_state": {
                  "type": "string",
                  "maxLength": 20
                },
                "context_window": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max_output": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "model_id",
                "label",
                "enabled",
                "free",
                "price_state",
                "context_window",
                "max_output"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "enabled",
          "base_url",
          "region",
          "deployment",
          "api_version",
          "key",
          "key_ref",
          "models"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "providers"
  ],
  "additionalProperties": false
}
